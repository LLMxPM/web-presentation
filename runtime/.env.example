# 文件用途：本地只读 fixture 与 SaaS 预览联调环境变量示例。

RUNTIME_PREVIEW_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
RUNTIME_SERVICE_TOKEN_AUDIENCE=runtime-backend

# Runtime 访问 Backend 内部只读产物 API 的根地址。
RUNTIME_BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Runtime dev server 监听地址与端口；容器镜像默认使用 0.0.0.0:7373。
RUNTIME_SERVER_HOST=127.0.0.1
RUNTIME_SERVER_PORT=7373
# 本地直连 Runtime 时保持相对根路径；平台同域 Gateway 部署时使用 /runtime/。
RUNTIME_SERVER_BASE_PATH=./
RUNTIME_LOG_LEVEL=info
RUNTIME_LOG_FORMAT=json
RUNTIME_ACCESS_LOG_ENABLED=true

# Runtime 预览上下文 JWS 的受众声明。
RUNTIME_PREVIEW_TOKEN_AUDIENCE=runtime-preview

# Backend 调用 Runtime 构建与诊断接口时使用的 audience。
RUNTIME_BUILD_TOKEN_AUDIENCE=runtime-build
RUNTIME_DIAGNOSTICS_TOKEN_AUDIENCE=runtime-diagnostics

# Runtime 诊断与正式构建共享的有界 Vite 调度器；lite/SQLite 保持 1，资源充足部署可设为 2。
RUNTIME_VITE_TASK_CONCURRENCY=1
RUNTIME_VITE_TASK_QUEUE_SIZE=16
RUNTIME_VITE_TASK_QUEUE_WAIT_TIMEOUT_MS=30000
RUNTIME_VITE_DIAGNOSTICS_WEIGHT=3

# Node/Vite worker 资源边界。正式构建默认 600 秒，单页诊断默认 120 秒。
RUNTIME_BUILD_WORKER_MAX_OLD_SPACE_MB=1024
RUNTIME_BUILD_WORKER_TIMEOUT_MS=600000
RUNTIME_DIAGNOSTICS_WORKER_TIMEOUT_MS=120000

# 诊断默认复用预热工作区和长期 IPC worker；可临时关闭复用以便故障回退。
RUNTIME_DIAGNOSTICS_WORKER_REUSE_ENABLED=true
RUNTIME_DIAGNOSTICS_WORKER_MAX_TASKS=25
RUNTIME_DIAGNOSTICS_WORKER_MAX_AGE_MS=1800000
RUNTIME_DIAGNOSTICS_WORKER_RSS_RECYCLE_RATIO=0.75

# Runtime 独立 fixture 页面入口是否可访问；设为 false 时仍保留 Backend 预览、构建与诊断链路。
RUNTIME_STANDALONE_PREVIEW_ENABLED=true

# 可选：本地只读 fixture 场景可通过浏览器注入 window.__RUNTIME_CONFIG_CONTEXT__
# 覆盖配置地址，不再建议使用环境变量直接指向任意远程 YAML。
