{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-presentation.local/schemas/component-preview-schema.v1.json",
  "title": "ComponentPreviewSchema",
  "description": "组件 previewSchema 生产结构校验与 Editor/Runtime 类型生成的单一源。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "props": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/propField"
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/slotField"
      }
    },
    "mocks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mockField"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "fieldType": {
      "type": "string",
      "enum": [
        "string",
        "textarea",
        "number",
        "boolean",
        "select",
        "json"
      ]
    },
    "selectOption": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "propField": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "$ref": "#/$defs/fieldType"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": true,
        "placeholder": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectOption"
          }
        },
        "agent_visible": {
          "type": "boolean"
        }
      }
    },
    "slotTextNode": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "text"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "slotHtmlNode": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "html"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "slotComponentNode": {
      "type": "object",
      "required": [
        "type",
        "component"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "component"
        },
        "component": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slotNode"
          }
        }
      }
    },
    "slotNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/slotTextNode"
        },
        {
          "$ref": "#/$defs/slotHtmlNode"
        },
        {
          "$ref": "#/$defs/slotComponentNode"
        }
      ]
    },
    "slotField": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slotNode"
          }
        }
      }
    },
    "mockField": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": true
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "key",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slotNode"
            }
          }
        },
        "mocks": {
          "type": "object"
        }
      }
    }
  },
  "x-typescript-types": {
    "#": "ComponentPreviewSchema",
    "#/$defs/fieldType": "ComponentPreviewFieldType",
    "#/$defs/selectOption": "ComponentPreviewSelectOption",
    "#/$defs/propField": "ComponentPreviewPropField",
    "#/$defs/slotTextNode": "ComponentPreviewSlotTextNode",
    "#/$defs/slotHtmlNode": "ComponentPreviewSlotHtmlNode",
    "#/$defs/slotComponentNode": "ComponentPreviewSlotComponentNode",
    "#/$defs/slotNode": "ComponentPreviewSlotNode",
    "#/$defs/slotField": "ComponentPreviewSlotField",
    "#/$defs/mockField": "ComponentPreviewMockField",
    "#/$defs/preset": "ComponentPreviewPreset"
  }
}
