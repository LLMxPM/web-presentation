# ==============================================================================
# 文件功能：web-presentation 全仓统一本地开发环境变量模板。
# 使用方式：在仓库根目录复制为 .env (cp .env.example .env) 并按需调整参数。
#
# 架构原则：
# 1. 根目录 .env 为全仓本地开发单一事实源，各子模块（Backend/Runtime/Editor/Renderer）
#    均默认向上级联读取本文件，无需在各子目录下重复维护。
# 2. 若子目录（如 backend/.env）存在同名变量，则优先使用子目录的局部覆盖值。
# 3. 生产部署请使用 deploy/.env 与 deploy/compose/compose.prod.yml。
# 4. 微观并发、租约、超时等隐式调优参数已由代码默认值托管，详见 docs/developer/deployment/env-vars.md。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础对外访问与跨模块共享 (SHARED & PLATFORM)
# ------------------------------------------------------------------------------
# 平台业务时区（统一以 Backend APP_TIMEZONE 为准，Editor 会自动读取；亦可在管理后台动态设置）
APP_TIMEZONE=Asia/Shanghai

# 后台对外基址（浏览器与外部客户端访问 Backend 的根路径）
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Runtime 对外基址（浏览器访问演示文稿预览的根路径）
RUNTIME_PUBLIC_BASE_URL=http://127.0.0.1:7373

# 后台允许跨域的前端来源列表（JSON 数组）
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 2. 跨模块安全凭证与通信契约 (SHARED SECRETS & CREDENTIALS)
# ------------------------------------------------------------------------------
# Backend 与 Renderer 远程渲染执行服务共享服务密钥（必须非空且非弱占位符）
RENDER_SERVICE_CREDENTIAL=local-dev-render-secret-key-32bytes-long!!
# 远程渲染环境特征摘要
RENDER_PROFILE_DIGEST=profile.v1

# Backend 与 Runtime Build Worker 领取构建任务的共享服务凭证
RUNTIME_BUILD_WORKER_CREDENTIAL=local-dev-build-worker-secret-key-32bytes!!

# ------------------------------------------------------------------------------
# 3. 后台服务底座 (BACKEND CORE & INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# 数据库连接串（支持 PostgreSQL 或开发用 SQLite）
# SQLite 开发模式示例：sqlite+aiosqlite:///./data/web_presentation.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/web_presentation

# 运行态存储（Redis 或轻量开发内存模式）
# 轻量内存模式示例：memory://lite
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=web_presentation

# 首次启动默认管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123456
DEFAULT_ADMIN_DISPLAY_NAME=平台系统管理员

# 用户会话配置
SESSION_COOKIE_NAME=wp_user_session
SESSION_TTL_HOURS=24
SESSION_SECURE=false

# ------------------------------------------------------------------------------
# 4. 服务间通信与 Worker 拓扑 (INTER-SERVICE COMMUNICATION)
# ------------------------------------------------------------------------------
# Backend 调用 Runtime 的内部地址
RUNTIME_BASE_URL=http://127.0.0.1:7373

# Runtime 回源 Backend 的内网 API 地址与 JWKS 验签地址
RUNTIME_BACKEND_API_BASE_URL=http://127.0.0.1:8000
RUNTIME_PREVIEW_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json

# 后台调用远程 Renderer 的 Worker 列表（JSON 数组）
RENDER_WORKERS_CONFIG=[{"worker_id":"renderer-local","base_url":"http://127.0.0.1:7400"}]

# ------------------------------------------------------------------------------
# 5. AI 智能体配置 (AI CORE)
# ------------------------------------------------------------------------------
AI_ENABLED=true
# 加密用户模型凭证的 Fernet 密钥（单机缺省时会自动生成并持久化；开发联调可指定固定测试密钥）
AI_SECRET_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# ------------------------------------------------------------------------------
# 6. 本地端口与开发代理 (LOCAL PORTS & DEV SERVER)
# ------------------------------------------------------------------------------
APP_PORT=8000
RUNTIME_SERVER_PORT=7373
RENDER_PORT=7400

# Vite 本地开发代理转发到 Backend 的目标地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 7. 可选系统配置锁定（类 B 配置；默认已可在 Web UI「系统设置」动态管理）
# 若在此显式声明，将以最高环境变量优先级锁定，禁止从 Web UI 修改：
# ------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# ASSET_STORAGE_DRIVER=local
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
