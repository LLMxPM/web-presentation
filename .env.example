# ==============================================================================
# 文件功能：web-presentation 全仓统一本地开发环境变量模板。
# 使用方式：在仓库根目录复制为 .env (cp .env.example .env) 并按需调整参数。
#
# 架构原则：
# 1. 根目录 .env 为全仓本地开发单一事实源，各子模块（Backend/Runtime/Editor/Renderer）
#    均默认向上级联读取本文件，无需在各子目录下重复维护。
# 2. 若子目录（如 backend/.env）存在同名变量，则优先使用子目录的局部覆盖值。
# 3. 生产部署请使用 deploy/.env 与 deploy/compose/compose.prod.yml。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础与跨模块共享配置 (SHARED & PLATFORM)
# ------------------------------------------------------------------------------
# 平台业务时区（统一以 Backend APP_TIMEZONE 为准，Editor 会自动读取）
APP_TIMEZONE=Asia/Shanghai

# 后台对外基址（浏览器与外部客户端访问 Backend 的根路径）
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Runtime 对外基址（浏览器访问演示文稿预览的根路径）
RUNTIME_PUBLIC_BASE_URL=http://127.0.0.1:7373

# 后台允许跨域的前端来源列表（JSON 数组）
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 2. 跨模块共享密钥与凭据 (SHARED SECRETS & AUDIENCE)
# ------------------------------------------------------------------------------
# Backend 与 Runtime 内部通信共享 Secret
RUNTIME_SHARED_SECRET=change-me

# Backend 与 Runtime 间令牌受众 (Audience) 声明（必须保持严格一致）
RUNTIME_SERVICE_TOKEN_AUDIENCE=runtime-backend
RUNTIME_PREVIEW_TOKEN_AUDIENCE=runtime-preview
RUNTIME_BUILD_TOKEN_AUDIENCE=runtime-build
RUNTIME_DIAGNOSTICS_TOKEN_AUDIENCE=runtime-diagnostics

# Backend 与 Renderer 远程渲染执行服务共享服务密钥（必须非空且非占位符）
RENDER_SERVICE_CREDENTIAL=local-dev-render-secret-key-32bytes-long!!
# 远程渲染环境特征摘要
RENDER_PROFILE_DIGEST=profile.v1

# ------------------------------------------------------------------------------
# 3. 后台服务配置 (BACKEND)
# ------------------------------------------------------------------------------
APP_NAME=页面管理后台
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=INFO
LOG_FORMAT=json
ACCESS_LOG_ENABLED=true
CLIENT_ERROR_LOG_ENABLED=true
CLIENT_ERROR_LOG_MAX_BYTES=16384

# 数据库连接串（支持 PostgreSQL 或开发用 SQLite）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/web_presentation
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# 运行态存储（Redis 或轻量开发内存模式）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=web_presentation
REDIS_HEALTHCHECK_TIMEOUT_SECONDS=2

# 首次启动默认管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123456
DEFAULT_ADMIN_DISPLAY_NAME=平台系统管理员

# 用户会话配置
SESSION_COOKIE_NAME=wp_user_session
SESSION_TTL_HOURS=24
SESSION_SECURE=false

# 后台调用 Runtime 的内部地址
RUNTIME_BASE_URL=http://127.0.0.1:7373
RUNTIME_REQUEST_TIMEOUT_SECONDS=10
RUNTIME_PREVIEW_ARTIFACT_TTL_SECONDS=3600
RUNTIME_BUILD_STATE_TTL_SECONDS=604800

# 后台调用远程 Renderer 的 Worker 列表（JSON 数组）
RENDER_WORKERS_CONFIG=[{"worker_id":"renderer-local","base_url":"http://127.0.0.1:7400"}]
RENDER_GLOBAL_CONCURRENCY=1
RENDER_WORKSPACE_CONCURRENCY=1
RENDER_QUEUE_SIZE=64
RENDER_WORKSPACE_QUEUE_SIZE=16
RENDER_REQUEST_TIMEOUT_SECONDS=120
RENDER_MAX_ATTEMPTS=3

# AI 模块配置
AI_ENABLED=true
AI_SECRET_ENCRYPTION_KEY=vmgRweOsDpMtYVW7SSpceINYcXlUHFNndAby6vRv0iA=
AI_AGENT_OS_ID=backend-agentos
AI_AGENT_TOKEN_TTL_SECONDS=600
AI_TOOL_AUTH_WINDOW_SECONDS=1800
AI_TOOL_AUTH_MAX_SECONDS=7200
AI_AGENT_STREAM_IDLE_TIMEOUT_SECONDS=180
AI_AGENT_TOOL_STREAM_IDLE_TIMEOUT_SECONDS=600
AI_EXTERNAL_TASK_ENQUEUE_TIMEOUT_SECONDS=30
AI_LLM_HTTP_TRACE_ENABLED=false
AI_LLM_HTTP_TRACE_DIR=.tmp/llm-http-trace
AI_LLM_HTTP_TRACE_BODY_MAX_BYTES=200000
AI_MODEL_CATALOG_SYNC_ENABLED=true
AI_PAGE_MUTATION_CONCURRENCY=1
AI_PAGE_MUTATION_MAX_ACTIVE_JOBS=16
AI_PAGE_MUTATION_MAX_BATCH_SIZE=16
AI_PAGE_MUTATION_POLL_INTERVAL_SECONDS=0.5

# 截图与重任务租约
PAGE_SCREENSHOT_DEFAULT_VIEWPORT_WIDTH=1920
PAGE_SCREENSHOT_DEFAULT_VIEWPORT_HEIGHT=1080
PAGE_SCREENSHOT_MAX_VIEWPORT_WIDTH=4096
PAGE_SCREENSHOT_MAX_VIEWPORT_HEIGHT=4096
PAGE_SCREENSHOT_TIMEOUT_SECONDS=45
PAGE_SCREENSHOT_VISUAL_READY_TIMEOUT_SECONDS=25
PAGE_SCREENSHOT_BATCH_CONCURRENCY=2
PAGE_SCREENSHOT_QUEUE_CONCURRENCY=1
PAGE_SCREENSHOT_QUEUE_POLL_INTERVAL_SECONDS=1
PAGE_SCREENSHOT_JOB_LEASE_SECONDS=180
PAGE_SCREENSHOT_AI_WAIT_TIMEOUT_SECONDS=90
PAGE_SCREENSHOT_LOCAL_ROOT=data
DURABLE_JOB_LEASE_SECONDS=300
DURABLE_JOB_HEARTBEAT_SECONDS=30

# 资源与对象存储配置
ASSET_STORAGE_DRIVER=local
# S3_ENDPOINT_URL=https://s3.your-region.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
# 字体可选走公开 bucket，其他资源继续走 S3_BUCKET 私有 bucket。
# S3_PUBLIC_BUCKET=your-public-font-bucket-name
# S3_REGION=your-region
# S3_PUBLIC_BASE_URL=https://your-public-font-bucket-domain.example.com

OBJECT_CACHE_IDLE_DAYS=30
OBJECT_CACHE_MAX_BYTES=10737418240
OBJECT_CACHE_SWEEP_INTERVAL_SECONDS=21600

# ------------------------------------------------------------------------------
# 4. 演示文稿运行时配置 (RUNTIME)
# ------------------------------------------------------------------------------
# Runtime 校验预览令牌的 Backend JWKS 地址与回源 API
RUNTIME_PREVIEW_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
RUNTIME_BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Runtime 服务监听
RUNTIME_SERVER_HOST=127.0.0.1
RUNTIME_SERVER_PORT=7373
RUNTIME_SERVER_BASE_PATH=./
RUNTIME_LOG_LEVEL=info
RUNTIME_LOG_FORMAT=json
RUNTIME_ACCESS_LOG_ENABLED=true
RUNTIME_STANDALONE_PREVIEW_ENABLED=true

# Runtime Vite 构建与诊断并发调度器
RUNTIME_VITE_TASK_CONCURRENCY=1
RUNTIME_VITE_TASK_QUEUE_SIZE=16
RUNTIME_VITE_TASK_QUEUE_WAIT_TIMEOUT_MS=30000
RUNTIME_VITE_DIAGNOSTICS_WEIGHT=3
RUNTIME_BUILD_WORKER_MAX_OLD_SPACE_MB=1024
RUNTIME_BUILD_WORKER_TIMEOUT_MS=600000
RUNTIME_DIAGNOSTICS_WORKER_TIMEOUT_MS=120000
RUNTIME_DIAGNOSTICS_WORKER_REUSE_ENABLED=true
RUNTIME_DIAGNOSTICS_WORKER_MAX_TASKS=25
RUNTIME_DIAGNOSTICS_WORKER_MAX_AGE_MS=1800000
RUNTIME_DIAGNOSTICS_WORKER_RSS_RECYCLE_RATIO=0.75

# ------------------------------------------------------------------------------
# 5. 远程渲染服务配置 (RENDERER)
# ------------------------------------------------------------------------------
RENDER_WORKER_ID=renderer-local
RENDER_HOST=0.0.0.0
RENDER_PORT=7400
RENDER_WORKSPACE_DIR=.tmp/renderer
RENDER_CLEANUP_GRACE_SECONDS=5.0
RENDER_RESULT_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 6. 编辑器前端配置 (EDITOR)
# ------------------------------------------------------------------------------
# Vite 本地开发代理转发到 Backend 的目标地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_CLIENT_ERROR_REPORTING=false
