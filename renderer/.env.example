# ==============================================================================
# 文件功能：独立 Renderer 执行服务本地开发环境变量示例。
#
# 说明：
# 本地开发推荐直接在仓库根目录维护统一的 .env，Renderer 会自动向上级联继承。
# 若需独立覆盖 Renderer 特定配置，可复制本文件为 renderer/.env。
# 注意：Renderer 凭证存在 fail-closed 检查，禁止使用占位符，且必须与 Backend 一致。
# ==============================================================================

RENDER_WORKER_ID=renderer-local
RENDER_HOST=0.0.0.0
RENDER_PORT=7400
# 与 Backend RENDER_SERVICE_CREDENTIAL 保持强一致的共享密钥
RENDER_SERVICE_CREDENTIAL=local-dev-render-secret-key-32bytes-long!!
# 或指向密钥文件（与内联密钥二选一）：
# RENDER_SERVICE_CREDENTIAL_FILE=/path/to/secret_file
RENDER_PROFILE_DIGEST=profile.v1
RENDER_WORKSPACE_DIR=.tmp/renderer
RENDER_CLEANUP_GRACE_SECONDS=5.0
RENDER_RESULT_TTL_SECONDS=600
