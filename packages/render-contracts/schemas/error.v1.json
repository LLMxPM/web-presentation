{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-presentation.local/schemas/render/error.v1.json",
  "title": "RenderError",
  "description": "统一渲染错误。错误码→HTTP 状态映射见 x-http-status-by-code（与 render_contracts.errors.error_http_status_table 同步）。",
  "type": "object",
  "required": ["code", "category", "stage", "retryable", "message"],
  "properties": {
    "code": {
      "enum": [
        "RENDER_QUEUE_FULL",
        "RENDER_WORKER_BUSY",
        "RENDER_SERVICE_UNAVAILABLE",
        "RENDER_CONTRACT_MISMATCH",
        "RENDER_PROFILE_MISMATCH",
        "RENDER_INPUT_EXPIRED",
        "RENDER_INPUT_NOT_REPRODUCIBLE",
        "RENDER_CONTENT_ERROR",
        "RENDER_ASSET_NOT_READY",
        "RENDER_BROWSER_LOST",
        "RENDER_DEADLINE_EXCEEDED",
        "RENDER_RESULT_LOST",
        "RENDER_OUTPUT_LIMIT_EXCEEDED",
        "RENDER_CANCELLED",
        "RENDER_INTERNAL_ERROR"
      ]
    },
    "category": {
      "enum": [
        "capacity",
        "infrastructure",
        "configuration",
        "input",
        "content",
        "resource",
        "timeout",
        "cancellation",
        "internal"
      ]
    },
    "stage": { "type": "string" },
    "retryable": { "type": "boolean" },
    "message": { "type": "string" },
    "trace_id": { "type": ["string", "null"] }
  },
  "x-http-status-by-code": {
    "description": "Backend 业务 API 将 RenderError 映射为 HTTP 响应时使用的状态码；未知码默认 500。",
    "type": "object",
    "additionalProperties": { "type": "integer", "minimum": 400, "maximum": 599 },
    "properties": {
      "RENDER_QUEUE_FULL": 429,
      "RENDER_WORKER_BUSY": 503,
      "RENDER_SERVICE_UNAVAILABLE": 503,
      "RENDER_CONTRACT_MISMATCH": 500,
      "RENDER_PROFILE_MISMATCH": 500,
      "RENDER_INPUT_EXPIRED": 409,
      "RENDER_INPUT_NOT_REPRODUCIBLE": 422,
      "RENDER_CONTENT_ERROR": 422,
      "RENDER_ASSET_NOT_READY": 409,
      "RENDER_BROWSER_LOST": 500,
      "RENDER_DEADLINE_EXCEEDED": 504,
      "RENDER_RESULT_LOST": 502,
      "RENDER_OUTPUT_LIMIT_EXCEEDED": 422,
      "RENDER_CANCELLED": 409,
      "RENDER_INTERNAL_ERROR": 500
    }
  }
}
