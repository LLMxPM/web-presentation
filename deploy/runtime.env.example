# 文件功能：分角色 Runtime 容器（runtime-preview / runtime-build / runtime-check）的非密钥配置示例。
# 复制为 deploy/runtime.env 后按部署域名与 audience 修改。不得写入任何平台凭证或密钥：
# DATABASE_URL、REDIS_URL、AI_SECRET_ENCRYPTION_KEY、RUNTIME_RSA_PRIVATE_KEY、
# DEFAULT_ADMIN_PASSWORD 以及服务凭证（RUNTIME_BUILD_WORKER_CREDENTIAL）
# 均严禁写入此文件。平台密钥只进 Backend 的 deploy/.env，构建凭证通过 Docker secret 独立挂载。
# 本文件中的域名 / audience / 路径应与 deploy/.env 中同名项保持一致，避免预览资源
# 指向错误域名或令牌校验失败。

# Backend 内网地址与 JWKS：Runtime 验签与回源换票使用。
RUNTIME_BACKEND_API_BASE_URL=http://backend:8000
RUNTIME_PREVIEW_JWKS_URL=http://backend:8000/.well-known/jwks.json

# 令牌 audience：必须与 Backend 侧 RUNTIME_*_TOKEN_AUDIENCE / RUNTIME_SERVICE_TOKEN_AUDIENCE 一致。
RUNTIME_SERVICE_TOKEN_AUDIENCE=runtime-backend
RUNTIME_PREVIEW_TOKEN_AUDIENCE=runtime-preview
RUNTIME_DIAGNOSTICS_TOKEN_AUDIENCE=runtime-diagnostics

# Runtime 服务监听与浏览器可访问地址。RUNTIME_PUBLIC_BASE_URL 应等于对外预览入口的
# Runtime 挂载地址（含 URL path）；RUNTIME_SERVER_BASE_PATH 与其 URL path 一致。
RUNTIME_SERVER_HOST=0.0.0.0
RUNTIME_SERVER_PORT=7373
RUNTIME_SERVER_BASE_PATH=/runtime/
RUNTIME_PUBLIC_BASE_URL=https://presentation.example.com/runtime

RUNTIME_LOG_LEVEL=info
RUNTIME_LOG_FORMAT=json
RUNTIME_ACCESS_LOG_ENABLED=false
RUNTIME_STANDALONE_PREVIEW_ENABLED=false

# 轻量内部工具（可视化编辑、资源比例测量）独立容量。
RUNTIME_LIGHT_TOOL_CONCURRENCY=2
RUNTIME_LIGHT_TOOL_QUEUE_SIZE=32
RUNTIME_LIGHT_TOOL_QUEUE_WAIT_TIMEOUT_MS=5000
RUNTIME_LIGHT_TOOL_TIMEOUT_MS=10000

RUNTIME_DIAGNOSTICS_REQUEST_TIMEOUT_SECONDS=180


# 可选：按角色细分 Vite 执行预算（未配置时回退 RUNTIME_VITE_TASK_*，见 compose 角色 environment）。
# RUNTIME_PREVIEW_VITE_TASK_CONCURRENCY=
# RUNTIME_BUILD_WORKER_MAX_OLD_SPACE_MB=
# RUNTIME_DIAGNOSTICS_WORKER_TIMEOUT_MS=
