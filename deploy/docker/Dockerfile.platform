# syntax=docker/dockerfile:1.7
# 文件功能：构建 web-presentation 平台单镜像，镜像内同时包含 Backend 服务与 Editor 静态资源。

FROM node:22-bookworm-slim AS editor-build

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

# pnpm workspace：根锁 + 成员清单，再按 filter 安装 editor
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY editor/package.json ./editor/
COPY runtime/package.json ./runtime/
RUN pnpm install --frozen-lockfile --filter editor...

COPY editor/ ./editor/
RUN pnpm --filter editor run build


FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS backend-deps

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app

# uv workspace：根锁 + 全部成员元数据与 render-contracts 可编辑源码
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml backend/README.md ./backend/
COPY renderer/pyproject.toml ./renderer/
COPY packages/render-contracts /app/packages/render-contracts
RUN uv sync --package backend --frozen --no-dev --no-cache --no-install-project


FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS platform-runtime

LABEL org.opencontainers.image.title="web-presentation"
LABEL org.opencontainers.image.description="web-presentation Backend and Editor platform image"

ENV APP_RELOAD=false
ENV ACCESS_LOG_ENABLED=false
ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV="/app/.venv"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl nginx \
    && rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY --from=backend-deps /app/.venv /app/.venv
COPY backend/ /app/backend/
COPY packages/render-contracts /app/packages/render-contracts
COPY runtime/src/runtime-kit/manifest/runtime-kit.manifest.json /app/runtime/src/runtime-kit/manifest/runtime-kit.manifest.json
COPY --from=editor-build /app/editor/dist/ /usr/share/nginx/html/
COPY deploy/docker/nginx/web-presentation.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/entrypoints/start_platform.sh /app/docker/entrypoints/start_platform.sh

RUN mkdir -p /app/backend/data /run/nginx /var/cache/nginx /var/log/nginx \
    && chmod +x /app/docker/entrypoints/start_platform.sh

EXPOSE 80 8000

CMD ["sh", "/app/docker/entrypoints/start_platform.sh"]
