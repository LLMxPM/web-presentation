# 文件功能：提供 production 编排所需环境变量示例，实际部署时复制为 deploy/.env 后替换密钥、域名和外部依赖地址。

# 本文件只供 deploy/compose/compose.prod.yml 通过 env_file: ../.env 读取。
# 两个简化版 compose/compose.yml 与 compose/compose.with-deps.yml 不读取本文件。

# 对外访问地址。常规同域 Gateway 模式下：
# - BACKEND_PUBLIC_BASE_URL 等于平台入口。
# - RUNTIME_PUBLIC_BASE_URL 为平台入口追加 /runtime。
# - RUNTIME_SERVER_BASE_PATH 与 RUNTIME_PUBLIC_BASE_URL 的 URL path 一致，使用 /runtime/。
# 独立 Runtime 域名模式下：
# - RUNTIME_PUBLIC_BASE_URL 示例：https://runtime.example.com
# - RUNTIME_SERVER_BASE_PATH 使用 /，表示 Runtime 挂载在独立域名根路径。
# 如单独暴露 Backend 或 Runtime 域名，应改成对应公网地址，并同步调整 CORS_ORIGINS。
BACKEND_PUBLIC_BASE_URL=https://presentation.example.com
RUNTIME_PUBLIC_BASE_URL=https://presentation.example.com/runtime
CORS_ORIGINS=["https://presentation.example.com"]
SESSION_SECURE=true
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FORMAT=json
ACCESS_LOG_ENABLED=false
CLIENT_ERROR_LOG_ENABLED=true
CLIENT_ERROR_LOG_MAX_BYTES=16384
# 远程渲染执行服务：Backend 不再安装 Playwright/Chromium。
# 必须生成强随机共享密钥写入 secret 文件，两侧（Backend/Renderer）一致；禁止使用占位符。
RENDER_WORKERS_CONFIG=[{"worker_id":"renderer-1","base_url":"http://renderer:7400"}]
RENDER_SERVICE_CREDENTIAL_FILE=/run/secrets/render_service_credential
RENDER_PROFILE_DIGEST=profile.v1
RENDER_GLOBAL_CONCURRENCY=2
RENDER_WORKSPACE_CONCURRENCY=1
RENDER_QUEUE_SIZE=64
RENDER_WORKSPACE_QUEUE_SIZE=16
RENDER_REQUEST_TIMEOUT_SECONDS=120
RENDER_MAX_ATTEMPTS=3
RENDER_RUNTIME_NAVIGATION_BASE_URL=https://presentation.example.com/runtime
RENDER_RUNTIME_ASSET_BASE_URL=https://presentation.example.com/runtime
RENDER_PLATFORM_ASSET_BASE_URL=https://presentation.example.com
DURABLE_JOB_LEASE_SECONDS=300
DURABLE_JOB_HEARTBEAT_SECONDS=30
RUNTIME_ARTIFACT_SWEEP_INTERVAL_SECONDS=30
# 进程内 memory:// 运行态的有限 payload 预算；常规 Redis 部署不使用这两个值。
RUNTIME_STATE_MEMORY_MAX_BYTES=134217728
RUNTIME_STATE_MEMORY_MAX_ITEM_BYTES=16777216

# production 编排使用已有 PostgreSQL 与 Redis，目标数据库和用户需要提前创建。
DATABASE_URL=postgresql+asyncpg://wp_user:change-postgres-password@postgres.example.internal:5432/web_presentation
REDIS_URL=redis://:change-redis-password@redis.example.internal:6379/0
REDIS_KEY_PREFIX=web_presentation

# 首次启动时使用的默认平台管理员。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-admin-password
DEFAULT_ADMIN_DISPLAY_NAME=平台系统管理员

# AI 配置密钥用于加密用户模型凭证，正式部署前必须重新生成并长期保存。
# 它不是 API Key，也不是普通密码。必须是 Fernet 密钥：32 字节随机值的 URL-safe base64 编码，
# 通常长度为 44 个字符并以 = 结尾。更换该值会导致已有用户模型凭证密文无法解密。
# 生成示例：python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 多 Backend 副本必须使用同一把 AI_SECRET_ENCRYPTION_KEY（经 secret 挂载或同一 env），否则跨副本无法解密凭证。
AI_ENABLED=true
AI_MODEL_CATALOG_SYNC_ENABLED=true
AI_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_AGENT_STREAM_IDLE_TIMEOUT_SECONDS=180
AI_AGENT_TOOL_STREAM_IDLE_TIMEOUT_SECONDS=600
AI_EXTERNAL_TASK_ENQUEUE_TIMEOUT_SECONDS=30
AI_PAGE_MUTATION_CONCURRENCY=2
AI_PAGE_MUTATION_MAX_ACTIVE_JOBS=64
AI_PAGE_MUTATION_MAX_BATCH_SIZE=16
AI_PAGE_MUTATION_POLL_INTERVAL_SECONDS=0.5

# Backend 与 Runtime 的容器内网访问关系，通常无需修改。
# RUNTIME_BASE_URL 是 Backend 调 Runtime 的内网地址，不是浏览器访问地址。
# 单 Runtime 模板（compose.prod.yml）指向 runtime:7373；分角色模板（compose.runtime-roles.yml）
# 会在 backend 服务上覆盖为 http://runtime-preview:7373，并可按职责覆盖下列角色目标。
# RUNTIME_PREVIEW/BUILD/CHECK_BASE_URL 分别是 Backend 调预览、构建、源码检查的内网地址；
# 留空统一回退 RUNTIME_BASE_URL，单 Runtime 部署无需改动。
RUNTIME_BASE_URL=http://runtime:7373
RUNTIME_PREVIEW_BASE_URL=
RUNTIME_BUILD_BASE_URL=
RUNTIME_CHECK_BASE_URL=
# 计算角色多副本：JSON 数组或逗号分隔的内网地址列表，留空回退上方单地址。
# 配置多目标后 Backend 按轮询选址，空闲副本可接单；仅开放给 build/check，preview 保持单目标。
# RUNTIME_BUILD_BASE_URLS=http://runtime-build-1:7373,http://runtime-build-2:7373
# RUNTIME_CHECK_BASE_URLS=http://runtime-check-1:7373,http://runtime-check-2:7373
RUNTIME_BUILD_BASE_URLS=
RUNTIME_CHECK_BASE_URLS=
# 选址冷却：目标连续失败达到阈值后短暂跳过（秒），冷却到期自动恢复参与轮询。
RUNTIME_TARGET_FAILURE_THRESHOLD=3
RUNTIME_TARGET_COOLDOWN_SECONDS=15
# 全链路准入：Backend 同时在途的 build/check/light 内部调用上限，超限返回稳定容量错误（503）。
# light（可视化编辑、资源比例测量）与 check 独立计数，避免长编译诊断队头阻塞轻量工具。
# 建议按「副本数 × 单副本执行预算」调整；<=0 表示不限制。
RUNTIME_BUILD_MAX_INFLIGHT=4
RUNTIME_CHECK_MAX_INFLIGHT=16
RUNTIME_LIGHT_MAX_INFLIGHT=16
RUNTIME_PREVIEW_JWKS_URL=http://backend:8000/.well-known/jwks.json
RUNTIME_SERVICE_TOKEN_AUDIENCE=runtime-backend
RUNTIME_PREVIEW_TOKEN_AUDIENCE=runtime-preview
RUNTIME_BUILD_TOKEN_AUDIENCE=runtime-build
RUNTIME_DIAGNOSTICS_TOKEN_AUDIENCE=runtime-diagnostics
RUNTIME_BACKEND_API_BASE_URL=http://backend:8000
RUNTIME_SERVER_HOST=0.0.0.0
RUNTIME_SERVER_PORT=7373
# Runtime 运行角色。单实例部署保持 all；分角色部署（compose.runtime-roles.yml）为
# runtime-preview / runtime-build / runtime-check 容器分别覆盖为 preview / build / check。
# preview 不开放构建与诊断入口，build/check 只保留对应执行面。
RUNTIME_ROLE=all
# Runtime Vite 资源挂载路径，应等于 RUNTIME_PUBLIC_BASE_URL 的 URL path。
# 例如 https://presentation.example.com/runtime 对应 /runtime/，https://runtime.example.com 对应 /。
RUNTIME_SERVER_BASE_PATH=/runtime/
RUNTIME_LOG_LEVEL=info
RUNTIME_LOG_FORMAT=json
RUNTIME_ACCESS_LOG_ENABLED=false
RUNTIME_STANDALONE_PREVIEW_ENABLED=false
# 版本指纹：排空/灰度时核对副本 build_id 与 /__runtime_healthz 输出一致。
RUNTIME_BUILD_ID=
RUNTIME_DIAGNOSTICS_REQUEST_TIMEOUT_SECONDS=180
RUNTIME_BUILD_REQUEST_TIMEOUT_SECONDS=900
# 项目构建持久领取：Runtime Build Worker 通过 claim API 领取并 renew 续租。
# 启动期校验会拒绝 PROJECT_BUILD_LEASE_SECONDS <= RUNTIME_BUILD_REQUEST_TIMEOUT_SECONDS（安全缺省）。
PROJECT_BUILD_LEASE_SECONDS=960
PROJECT_BUILD_MAX_ATTEMPTS=3
PROJECT_BUILD_TOTAL_DEADLINE_SECONDS=3600
PROJECT_BUILD_QUEUE_CONCURRENCY=1
PROJECT_BUILD_QUEUE_POLL_INTERVAL_SECONDS=1.0
# Runtime Build Worker 领取任务用的共享服务凭证；两侧（Backend 与 runtime-build）必须一致。
# 未配置时 claim API fail-closed，且 runtime Worker 不启动——构建任务会一直 pending。
# 生产请用强随机值或 secret 文件（RUNTIME_BUILD_WORKER_CREDENTIAL_FILE），禁止占位符。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNTIME_BUILD_WORKER_CREDENTIAL=
# RUNTIME_BUILD_WORKER_CREDENTIAL_FILE=/run/secrets/build_worker_credential
RUNTIME_VITE_TASK_CONCURRENCY=2
RUNTIME_VITE_TASK_QUEUE_SIZE=16
RUNTIME_VITE_TASK_QUEUE_WAIT_TIMEOUT_MS=30000
RUNTIME_VITE_DIAGNOSTICS_WEIGHT=3
# 分类别执行预算：未配置时回退上方 RUNTIME_VITE_TASK_*；按角色部署时也可用
# RUNTIME_PREVIEW/BUILD/CHECK_VITE_TASK_* 覆盖。
# RUNTIME_VITE_DIAGNOSTICS_CONCURRENCY=
# RUNTIME_VITE_PROJECT_CONCURRENCY=
# 轻量内部工具（可视化编辑、资源比例测量）独立容量，短请求不排在长编译后。
RUNTIME_LIGHT_TOOL_CONCURRENCY=2
RUNTIME_LIGHT_TOOL_QUEUE_SIZE=32
RUNTIME_LIGHT_TOOL_QUEUE_WAIT_TIMEOUT_MS=5000
RUNTIME_LIGHT_TOOL_TIMEOUT_MS=10000
RUNTIME_BUILD_WORKER_MAX_OLD_SPACE_MB=2048
RUNTIME_BUILD_WORKER_TIMEOUT_MS=600000
RUNTIME_DIAGNOSTICS_WORKER_TIMEOUT_MS=120000
RUNTIME_DIAGNOSTICS_WORKER_REUSE_ENABLED=true
RUNTIME_DIAGNOSTICS_WORKER_MAX_TASKS=25
RUNTIME_DIAGNOSTICS_WORKER_MAX_AGE_MS=1800000
RUNTIME_DIAGNOSTICS_WORKER_RSS_RECYCLE_RATIO=0.75

# 资源存储。local 会写入 backend-data volume；对象存储部署时改为 s3 并补齐 S3_*。
# 多 Backend 副本必须共享同一对象存储（推荐 s3）；如使用本地目录，必须是所有副本挂载的共享卷，
# 且显式设置 OBJECT_STORAGE_SHARED_VOLUME=true 确认，否则启动校验拒绝。
ASSET_STORAGE_DRIVER=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
# OBJECT_STORAGE_SHARED_VOLUME=false

# Runtime RS256 签名身份（预览/构建/诊断/服务令牌）。读取顺序：
# 1) RUNTIME_RSA_PRIVATE_KEY：PEM 私钥文本（env，不推荐长期使用）；
# 2) RUNTIME_RSA_PRIVATE_KEY_FILE：PEM 私钥文件路径（共享路径 / Docker secret 挂载）；
# 3) 旧版本地 data/runtime_rsa_key.pem；4) 仅单实例/Lite 自动生成（默认允许）。
# 多 Backend 副本必须通过 1) 或 2) 提供实例间共享的同一把私钥，启动校验会拒绝缺省自动生成；
# 否则各副本各自生成不同密钥，任一副本无法校验另一副本签发的票据。详见
# docs/developer/deployment/multi-backend.md。
# RUNTIME_RSA_PRIVATE_KEY_FILE=/run/secrets/runtime_rsa_private_key
# RUNTIME_RSA_PRIVATE_KEY=
RUNTIME_RSA_KEY_ID=default-key-1
# 密钥轮换期保留的旧钥（仅验签 + 公布 JWKS）：JSON 数组，每项 kid + private_key_file 或 private_key。
# 轮换期间旧票据在自身 TTL 内仍有效；从该列表移除旧钥后，旧钥签发的票据立即失效。
# RUNTIME_RSA_PREVIOUS_KEYS=[{"kid":"default-key-1","private_key_file":"/run/secrets/runtime_rsa_key_v1"}]
RUNTIME_RSA_PREVIOUS_KEYS=[]
# 单实例/Lite 允许缺省时自动生成本地私钥；多 Backend 必须显式提供共享私钥并保持默认 true 无影响。
RUNTIME_RSA_ALLOW_AUTO_GENERATE=true
# 声明本部署运行多 Backend 副本：启动期强制共享签名私钥、AI/Renderer 凭证、对象存储与真实 Redis。
# 单实例部署保持 false。多副本说明与密钥轮换流程见 docs/developer/deployment/multi-backend.md。
BACKEND_MULTI_INSTANCE=false
