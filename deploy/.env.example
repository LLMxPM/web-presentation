# 文件功能：提供 production 编排所需环境变量示例，实际部署时复制为 deploy/.env 后替换密钥、域名和外部依赖地址。
# 本文件供 deploy/compose/compose.prod.yml 与 deploy/compose/compose.runtime-roles.yml 读取。
# 轻量单容器版（compose.sqlite-lite.yml）无需本文件，支持零配置启动。

# ==============================================================================
# 1. 对外访问入口（类 A：基础设施必需）
# ==============================================================================
BACKEND_PUBLIC_BASE_URL=https://presentation.example.com
RUNTIME_PUBLIC_BASE_URL=https://presentation.example.com/runtime
CORS_ORIGINS=["https://presentation.example.com"]
SESSION_SECURE=true

# ==============================================================================
# 2. 基础设施底座（类 A：基础设施必需）
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://wp_user:change-postgres-password@postgres.example.internal:5432/web_presentation
REDIS_URL=redis://:change-redis-password@redis.example.internal:6379/0
REDIS_KEY_PREFIX=web_presentation

# ==============================================================================
# 3. 默认管理员账号（首启播种，生产必填）
# ==============================================================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DEFAULT_ADMIN_DISPLAY_NAME=平台系统管理员

# ==============================================================================
# 4. 平台密钥与凭据（必须长期保存并进备份集；禁止使用占位符）
# ==============================================================================
# AI 配置密钥用于加密模型凭证，必须是 32 字节随机值的 URL-safe base64（长度 44 字符以 = 结尾）：
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_SECRET_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Runtime 构建任务共享凭证（Backend 与 runtime-build 容器一致）：
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNTIME_BUILD_WORKER_CREDENTIAL=REPLACE_WITH_STRONG_BUILD_CREDENTIAL

# ==============================================================================
# 5. 远程渲染服务（生产多容器拓扑必需）
# ==============================================================================
# Backend 通过此配置与独立 Renderer 通信；两端共享凭证建议通过 Docker secrets 挂载
RENDER_WORKERS_CONFIG=[{"worker_id":"renderer-1","base_url":"http://renderer:7400"}]
RENDER_SERVICE_CREDENTIAL_FILE=/run/secrets/render_service_credential
RENDER_PROFILE_DIGEST=profile.v1

# ==============================================================================
# 6. 容器内网服务通信
# ==============================================================================
# Backend 调用 Runtime 的容器内网地址；单 Runtime 模板指向 http://runtime:7373
RUNTIME_BASE_URL=http://runtime:7373

# ==============================================================================
# 7. 签名身份与多副本模式（生产多副本必需；单机保持默认）
# ==============================================================================
# 声明是否运行多 Backend 副本；开启后强制共享签名私钥、共享存储与真实 Redis
BACKEND_MULTI_INSTANCE=false
RUNTIME_RSA_KEY_ID=default-key-1
# 多 Backend 必须挂载同一私钥（推荐 secret 文件）：
# RUNTIME_RSA_PRIVATE_KEY_FILE=/run/secrets/runtime_rsa_private_key

# ==============================================================================
# 8. 业务时区与日志格式（可选常规配置）
# ==============================================================================
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# 9. 对象存储配置（可选；多副本生产环境推荐配置 S3）
# ==============================================================================
ASSET_STORAGE_DRIVER=local
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_PUBLIC_BUCKET=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
